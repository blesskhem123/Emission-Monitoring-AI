@model AnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-graph-up me-2 text-info"></i>Analytics</h4>
        <small class="text-muted">Historical NOx emission trends and prediction accuracy</small>
    </div>
</div>

<!-- Date Range Filter -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-medium">From Date</label>
                <input type="date" name="from" class="form-control"
                       value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-medium">To Date</label>
                <input type="date" name="to" class="form-control"
                       value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i>Apply Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Summary Stats Row -->
<div class="row g-3 mb-4">
    @foreach (var (label, val, icon, color) in new[]{
        ("Total Readings",   Model.TotalReadings.ToString(),        "table",                    "primary"),
        ("Avg Current NOx",  Model.AvgCurrentNox + " ppm",          "wind",                     "info"),
        ("Avg Predicted NOx",Model.AvgPredictedNox + " ppm",        "cpu",                      "warning"),
        ("Max Predicted NOx",Model.MaxPredictedNox.ToString("F1")+" ppm","arrow-up-circle",     "danger"),
    })
    {
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle p-2 bg-@color-subtle text-@color">
                        <i class="bi bi-@icon fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">@label</div>
                        <div class="fw-bold fs-5">@val</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Risk Distribution Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <div class="h2 fw-bold text-success">@Model.SafeCount</div>
                <div class="text-muted small">Safe Readings</div>
                <div class="progress mt-2" style="height:6px;">
                    <div class="progress-bar bg-success"
                         style="width:@(Model.TotalReadings>0?Model.SafeCount*100/Model.TotalReadings:0)%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <div class="h2 fw-bold text-warning">@Model.WarningCount</div>
                <div class="text-muted small">Warning Alerts</div>
                <div class="progress mt-2" style="height:6px;">
                    <div class="progress-bar bg-warning"
                         style="width:@(Model.TotalReadings>0?Model.WarningCount*100/Model.TotalReadings:0)%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <div class="h2 fw-bold text-danger">@Model.CriticalCount</div>
                <div class="text-muted small">Critical Alerts</div>
                <div class="progress mt-2" style="height:6px;">
                    <div class="progress-bar bg-danger"
                         style="width:@(Model.TotalReadings>0?Model.CriticalCount*100/Model.TotalReadings:0)%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NOx Trend Chart -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-bottom">
        <h6 class="fw-bold mb-0"><i class="bi bi-graph-up me-2 text-primary"></i>NOx Trend — Current vs Predicted</h6>
    </div>
    <div class="card-body">
        <canvas id="noxTrendChart" height="80"></canvas>
    </div>
</div>

<!-- Fuel & Load Chart -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="fw-bold mb-0"><i class="bi bi-fire me-2 text-danger"></i>Fuel Consumption Trend</h6>
            </div>
            <div class="card-body">
                <canvas id="fuelChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="fw-bold mb-0"><i class="bi bi-speedometer me-2 text-info"></i>Production Load Trend</h6>
            </div>
            <div class="card-body">
                <canvas id="loadChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const labels       = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Labels));
const currentNox   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CurrentNoxData));
const predictedNox = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PredictedNoxData));
const fuelData     = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FuelData));
const loadData     = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LoadData));

// Common options
const commonOpts = {
    responsive: true,
    plugins: { legend: { position: 'top' } },
    scales: { x: { ticks: { maxTicksLimit: 10 } } }
};

// NOx Chart
new Chart(document.getElementById('noxTrendChart'), {
    type: 'line',
    data: {
        labels,
        datasets: [
            { label: 'Current NOx (ppm)', data: currentNox, borderColor: '#0d6efd',
              backgroundColor: 'rgba(13,110,253,0.07)', fill: true, tension: 0.3, pointRadius: 2 },
            { label: 'Predicted NOx (ppm)', data: predictedNox, borderColor: '#fd7e14',
              borderDash: [5,3], fill: false, tension: 0.3, pointRadius: 2 }
        ]
    },
    options: { ...commonOpts, scales: { ...commonOpts.scales, y: { title: { display: true, text: 'NOx (ppm)' } } } }
});

// Fuel Chart
new Chart(document.getElementById('fuelChart'), {
    type: 'bar',
    data: {
        labels,
        datasets: [{ label: 'Fuel (kg/hr)', data: fuelData,
            backgroundColor: 'rgba(220,53,69,0.6)', borderColor: '#dc3545', borderWidth: 1 }]
    },
    options: commonOpts
});

// Load Chart
new Chart(document.getElementById('loadChart'), {
    type: 'line',
    data: {
        labels,
        datasets: [{ label: 'Production Load (%)', data: loadData,
            borderColor: '#0dcaf0', backgroundColor: 'rgba(13,202,240,0.08)',
            fill: true, tension: 0.3, pointRadius: 2 }]
    },
    options: { ...commonOpts, scales: { ...commonOpts.scales, y: { min: 0, max: 110 } } }
});
</script>
}
