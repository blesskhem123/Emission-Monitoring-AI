@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register — Emission Monitoring System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family:'Inter',sans-serif; background:linear-gradient(135deg,#0f2027,#203a43,#2c5364); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:2rem 0; }
        .register-card { background:#fff; border-radius:16px; box-shadow:0 20px 60px rgba(0,0,0,.4); width:100%; max-width:460px; padding:2.5rem; }
        .brand-icon { width:56px; height:56px; background:linear-gradient(135deg,#198754,#20c997); border-radius:12px; display:flex; align-items:center; justify-content:center; margin:0 auto 1rem; }
        .form-control:focus,.form-select:focus { border-color:#198754; box-shadow:0 0 0 .2rem rgba(25,135,84,.15); }
        .role-card { border:2px solid #dee2e6; border-radius:10px; padding:.75rem 1rem; cursor:pointer; transition:all .2s; }
        .role-card:hover { border-color:#198754; background:#f8fff9; }
        .role-card.selected { border-color:#198754; background:#d1e7dd; }
        .role-card input { display:none; }
    </style>
</head>
<body>
<div class="register-card">
    <div class="text-center mb-3">
        <div class="brand-icon"><i class="bi bi-activity text-white fs-3"></i></div>
        <h5 class="fw-bold mb-0">Create Account</h5>
        <p class="text-muted small mb-0">Emission Monitoring System — Panipat Refinery</p>
    </div>

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label fw-medium small">Full Name</label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                <input asp-for="FullName" class="form-control" placeholder="Rajesh Kumar" />
            </div>
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-medium small">Email Address</label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                <input asp-for="Email" class="form-control" placeholder="rajesh@panipat.iocl.com" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-6">
                <label asp-for="Password" class="form-label fw-medium small">Password</label>
                <input asp-for="Password" class="form-control" placeholder="Min 6 chars" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="ConfirmPassword" class="form-label fw-medium small">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        <!-- Role selection as visual cards -->
        <div class="mb-3">
            <label class="form-label fw-medium small">Select Your Role</label>
            <div class="d-flex gap-2">
                <label class="role-card flex-fill text-center" id="card-Operator">
                    <input type="radio" name="Role" value="Operator" checked onchange="selectRole(this)" />
                    <i class="bi bi-person-gear d-block fs-4 text-primary mb-1"></i>
                    <div class="fw-semibold small">Operator</div>
                    <div class="text-muted" style="font-size:.7rem;">Submit & view</div>
                </label>
                <label class="role-card flex-fill text-center" id="card-Viewer">
                    <input type="radio" name="Role" value="Viewer" onchange="selectRole(this)" />
                    <i class="bi bi-eye d-block fs-4 text-info mb-1"></i>
                    <div class="fw-semibold small">Viewer</div>
                    <div class="text-muted" style="font-size:.7rem;">Read only</div>
                </label>
                <label class="role-card flex-fill text-center" id="card-Admin">
                    <input type="radio" name="Role" value="Admin" onchange="selectRole(this)" />
                    <i class="bi bi-shield-check d-block fs-4 text-success mb-1"></i>
                    <div class="fw-semibold small">Admin</div>
                    <div class="text-muted" style="font-size:.7rem;">Full access</div>
                </label>
            </div>
        </div>

        <button type="submit" class="btn btn-success w-100 fw-semibold">
            <i class="bi bi-person-check me-2"></i>Create Account
        </button>
    </form>

    <div class="text-center mt-3">
        <small class="text-muted">Already have an account?
            <a asp-controller="Account" asp-action="Login" class="text-success fw-medium">Sign In</a>
        </small>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Highlight selected role card
    function selectRole(radio) {
        document.querySelectorAll('.role-card').forEach(c => c.classList.remove('selected'));
        document.getElementById('card-' + radio.value).classList.add('selected');
    }
    // Default highlight
    document.getElementById('card-Operator').classList.add('selected');
</script>
</body>
</html>
