@{
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center">
        <div class="mb-4"
             style="width:90px;height:90px;background:linear-gradient(135deg,#dc3545,#e74c3c);
                    border-radius:20px;display:flex;align-items:center;
                    justify-content:center;margin:0 auto;">
            <i class="bi bi-shield-x text-white" style="font-size:2.5rem;"></i>
        </div>
        <h3 class="fw-bold mb-2">Access Denied</h3>
        <p class="text-muted mb-4">
            You don't have permission to access this page.<br />
            This area requires <strong>Admin</strong> privileges.
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <a asp-controller="Dashboard" asp-action="Index"
               class="btn btn-success">
                <i class="bi bi-house me-2"></i>Go to Dashboard
            </a>
            <a asp-controller="Account" asp-action="Logout"
               class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
            </a>
        </div>
    </div>
</div>
