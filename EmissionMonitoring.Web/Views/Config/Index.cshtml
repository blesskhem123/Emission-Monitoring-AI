@model PlantConfigViewModel
@{
    ViewData["Title"] = "Plant Configuration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-sliders me-2 text-primary"></i>Plant Configuration</h4>
        <small class="text-muted">Configure NOx emission thresholds for CPCB compliance</small>
    </div>
    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
        <i class="bi bi-shield-lock me-1"></i>Admin Only
    </span>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="fw-bold mb-0"><i class="bi bi-building me-2"></i>Plant Details & NOx Limits</h6>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="PlantId" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="PlantName" class="form-label fw-medium small">Plant Name</label>
                            <input asp-for="PlantName" class="form-control" />
                            <span asp-validation-for="PlantName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="PlantType" class="form-label fw-medium small">Plant Type</label>
                            <select asp-for="PlantType" class="form-select"
                                    asp-items="@(new SelectList(Model.PlantTypes))"></select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-medium small">Location</label>
                        <input asp-for="Location" class="form-control" />
                    </div>

                    <hr class="my-3" />
                    <h6 class="fw-bold text-muted mb-3">
                        <i class="bi bi-sliders2 me-2"></i>NOx Emission Thresholds (ppm)
                    </h6>

                    <!-- Safe Limit -->
                    <div class="mb-3">
                        <label asp-for="NoxSafeLimit" class="form-label fw-medium small d-flex justify-content-between">
                            <span><i class="bi bi-circle-fill text-success me-1" style="font-size:.6rem;"></i>Safe Limit</span>
                            <span class="badge bg-success" id="safe-badge">@Model.NoxSafeLimit ppm</span>
                        </label>
                        <input asp-for="NoxSafeLimit" type="range" class="form-range"
                               min="10" max="150" step="5"
                               oninput="document.getElementById('safe-badge').textContent=this.value+' ppm'; document.getElementById('NoxSafeLimit_num').value=this.value;" />
                        <input id="NoxSafeLimit_num" type="number" value="@Model.NoxSafeLimit"
                               class="form-control form-control-sm mt-1" style="width:100px;"
                               oninput="document.querySelector('[name=NoxSafeLimit]').value=this.value; document.getElementById('safe-badge').textContent=this.value+' ppm';" />
                        <span asp-validation-for="NoxSafeLimit" class="text-danger small"></span>
                    </div>

                    <!-- Warning Limit -->
                    <div class="mb-3">
                        <label asp-for="NoxWarningLimit" class="form-label fw-medium small d-flex justify-content-between">
                            <span><i class="bi bi-circle-fill text-warning me-1" style="font-size:.6rem;"></i>Warning Limit</span>
                            <span class="badge bg-warning text-dark" id="warn-badge">@Model.NoxWarningLimit ppm</span>
                        </label>
                        <input asp-for="NoxWarningLimit" type="range" class="form-range"
                               min="20" max="200" step="5"
                               oninput="document.getElementById('warn-badge').textContent=this.value+' ppm'; document.getElementById('NoxWarningLimit_num').value=this.value;" />
                        <input id="NoxWarningLimit_num" type="number" value="@Model.NoxWarningLimit"
                               class="form-control form-control-sm mt-1" style="width:100px;"
                               oninput="document.querySelector('[name=NoxWarningLimit]').value=this.value; document.getElementById('warn-badge').textContent=this.value+' ppm';" />
                        <span asp-validation-for="NoxWarningLimit" class="text-danger small"></span>
                    </div>

                    <!-- Critical Limit -->
                    <div class="mb-4">
                        <label asp-for="NoxCriticalLimit" class="form-label fw-medium small d-flex justify-content-between">
                            <span><i class="bi bi-circle-fill text-danger me-1" style="font-size:.6rem;"></i>Critical Limit</span>
                            <span class="badge bg-danger" id="crit-badge">@Model.NoxCriticalLimit ppm</span>
                        </label>
                        <input asp-for="NoxCriticalLimit" type="range" class="form-range"
                               min="30" max="250" step="5"
                               oninput="document.getElementById('crit-badge').textContent=this.value+' ppm'; document.getElementById('NoxCriticalLimit_num').value=this.value;" />
                        <input id="NoxCriticalLimit_num" type="number" value="@Model.NoxCriticalLimit"
                               class="form-control form-control-sm mt-1" style="width:100px;"
                               oninput="document.querySelector('[name=NoxCriticalLimit]').value=this.value; document.getElementById('crit-badge').textContent=this.value+' ppm';" />
                        <span asp-validation-for="NoxCriticalLimit" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary fw-semibold px-4">
                        <i class="bi bi-save me-2"></i>Save Configuration
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Info Panel -->
    <div class="col-xl-5">
        <div class="card border-0 shadow-sm bg-light mb-3">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-info"></i>CPCB Reference Limits</h6>
                <table class="table table-sm table-borderless mb-0">
                    <thead><tr><th class="text-muted small">Plant Type</th><th class="text-muted small">NOx Limit</th></tr></thead>
                    <tbody class="small">
                        <tr><td>Petroleum Refinery</td><td><strong>100 ppm</strong></td></tr>
                        <tr><td>Thermal Power Plant</td><td><strong>50–100 mg/Nm³</strong></td></tr>
                        <tr><td>Gas Processing Plant</td><td><strong>75 ppm</strong></td></tr>
                        <tr><td>Fertilizer Plant</td><td><strong>150 ppm</strong></td></tr>
                    </tbody>
                </table>
                <small class="text-muted d-block mt-2">
                    Source: CPCB Emission Standards, MoEF&CC India
                </small>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-2"><i class="bi bi-lightbulb me-2 text-warning"></i>Current Configuration</h6>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge bg-success p-2">Safe &lt; @Model.NoxSafeLimit ppm</span>
                    <span class="badge bg-warning text-dark p-2">Warning @Model.NoxSafeLimit–@Model.NoxWarningLimit ppm</span>
                    <span class="badge bg-danger p-2">Critical &gt; @Model.NoxWarningLimit ppm</span>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    <i class="bi bi-arrow-right me-1"></i>
                    Changes take effect on the next prediction. Flask API will use
                    these limits for risk classification.
                </p>
            </div>
        </div>
    </div>
</div>
