@model EmissionMonitoring.Web.Models.Entities.PlantReading
@{
    ViewData["Title"] = "Reading Details";
    var pred = Model.Prediction;
    var riskColor = pred?.RiskLevel switch {
        "Critical" => "danger",
        "Warning"  => "warning",
        "Safe"     => "success",
        _          => "secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-file-earmark-text me-2 text-primary"></i>
            Reading #@Model.ReadingId — Details
        </h4>
        <small class="text-muted">
            Submitted: @Model.ReadingTimestamp.ToString("dd MMM yyyy, HH:mm") |
            Plant: @(Model.Plant?.PlantName ?? "—")
        </small>
    </div>
    <a asp-controller="Readings" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to History
    </a>
</div>

<div class="row g-4">

    <!-- Input Parameters -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-bottom">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-input-cursor-text me-2 text-primary"></i>Plant Sensor Inputs
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 bg-primary bg-opacity-10 rounded text-center">
                            <i class="bi bi-fire text-primary fs-4 d-block mb-1"></i>
                            <div class="text-muted small">Fuel Consumption</div>
                            <div class="fw-bold fs-5">@Model.FuelConsumption.ToString("F1")</div>
                            <div class="text-muted small">kg/hr</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-info bg-opacity-10 rounded text-center">
                            <i class="bi bi-speedometer text-info fs-4 d-block mb-1"></i>
                            <div class="text-muted small">Production Load</div>
                            <div class="fw-bold fs-5">@Model.ProductionLoad.ToString("F1")</div>
                            <div class="text-muted small">%</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-warning bg-opacity-10 rounded text-center">
                            <i class="bi bi-thermometer-half text-warning fs-4 d-block mb-1"></i>
                            <div class="text-muted small">Stack Temperature</div>
                            <div class="fw-bold fs-5">@Model.Temperature.ToString("F0")</div>
                            <div class="text-muted small">°C</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-success bg-opacity-10 rounded text-center">
                            <i class="bi bi-wind text-success fs-4 d-block mb-1"></i>
                            <div class="text-muted small">Current NOx</div>
                            <div class="fw-bold fs-5">@Model.CurrentNox.ToString("F1")</div>
                            <div class="text-muted small">ppm</div>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="row g-2 text-muted small">
                    <div class="col-6">
                        <i class="bi bi-person me-1"></i>
                        Entered by:
                        <strong>@(Model.EnteredByUser?.FullName ?? "Unknown")</strong>
                    </div>
                    <div class="col-6">
                        <i class="bi bi-clock me-1"></i>
                        Time:
                        <strong>@Model.ReadingTimestamp.ToString("HH:mm, dd-MMM-yyyy")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Prediction Result -->
    <div class="col-md-6">
        @if (pred != null)
        {
            <div class="card border-0 shadow-sm border-top border-4 border-@riskColor">
                <div class="card-header bg-transparent border-bottom d-flex justify-content-between">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-robot me-2"></i>AI Prediction Result
                    </h6>
                    <span class="badge bg-@riskColor fs-6">@pred.RiskLevel</span>
                </div>
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">PREDICTED NOx — NEXT HOUR</div>
                    <div class="display-5 fw-bold text-@riskColor mb-1">
                        @pred.PredictedNox.ToString("F1")
                        <span class="fs-5 text-muted">ppm</span>
                    </div>

                    @{
                        var change = pred.PredictedNox - Model.CurrentNox;
                    }
                    <div class="mb-3">
                        <i class="bi bi-arrow-@(change > 0 ? "up" : "down")-circle-fill
                           text-@(change > 0 ? "danger" : "success") me-1"></i>
                        <span class="fw-semibold">
                            @(change > 0 ? "+" : "")@change.ToString("F1") ppm
                        </span>
                        <span class="text-muted small">vs current</span>
                    </div>

                    <div class="alert alert-@riskColor border-0 text-start small">
                        <i class="bi bi-info-circle me-1"></i>@pred.AlertMessage
                    </div>

                    <div class="row g-2 text-muted small border-top pt-3">
                        <div class="col-6 text-start">
                            <i class="bi bi-graph-up me-1"></i>
                            Model R²: <strong>@pred.ModelConfidence?.ToString("P0")</strong>
                        </div>
                        <div class="col-6 text-end">
                            <i class="bi bi-clock me-1"></i>
                            At: <strong>@pred.PredictedAt.ToString("HH:mm")</strong>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5">
                    <i class="bi bi-exclamation-circle text-warning fs-1 d-block mb-3"></i>
                    <h6 class="fw-bold">No Prediction Available</h6>
                    <p class="text-muted small">
                        The ML service may have been offline when this reading was submitted.
                    </p>
                </div>
            </div>
        }
    </div>
</div>
