<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="Emission Monitoring AI/EmissionMonitoring.Web/wwwroot/images/indianoil.png" />
    <title>@ViewData["Title"] — Emission Monitoring System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
<div class="d-flex" id="wrapper">
    <nav id="sidebar" class="sidebar">
        <div class="sidebar-brand">
            <img src="~/images/indianoil.png" 
                alt="IOCL" 
                style="width:36px; height:36px; object-fit:contain; border-radius:50%; margin-right:8px;" />
            <span>EMS <small class="text-muted fw-normal">v1.0</small></span>
        </div>
        <div class="sidebar-plant-badge">
            <i class="bi bi-building me-1"></i>
            <small>Panipat Refinery</small>
        </div>
        <hr class="sidebar-divider" />
        <ul class="nav flex-column sidebar-nav">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Dashboard"?"active":"")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Readings"&&ViewContext.RouteData.Values["action"]?.ToString()=="Submit"?"active":"")"
                   asp-controller="Readings" asp-action="Submit">
                    <i class="bi bi-plus-circle"></i> Submit Reading
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Readings"&&ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")"
                   asp-controller="Readings" asp-action="Index">
                    <i class="bi bi-table"></i> Reading History
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Alerts"?"active":"")"
                   asp-controller="Alerts" asp-action="Index">
                    <i class="bi bi-bell"></i> Alert Center
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Analytics"?"active":"")"
                   asp-controller="Analytics" asp-action="Index">
                    <i class="bi bi-graph-up"></i> Analytics
                </a>
            </li>
            @if (User.IsInRole("Admin"))
            {
            <hr class="sidebar-divider" />
            <li class="nav-item sidebar-heading">Admin</li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Config"?"active":"")"
                   asp-controller="Config" asp-action="Index">
                    <i class="bi bi-sliders"></i> Plant Config
                </a>
            </li>
            }
        </ul>
        <div class="sidebar-footer">
            <div class="d-flex align-items-center gap-2">
                <div class="user-avatar">@(User.Identity?.Name?.Substring(0,1).ToUpper())</div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="small fw-semibold text-truncate">@User.Identity?.Name</div>
                    <div class="text-muted" style="font-size:0.7rem;">
                        @(User.IsInRole("Admin")?"Administrator":User.IsInRole("Operator")?"Plant Operator":"Viewer")
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <div id="page-content-wrapper" class="flex-grow-1">
        <nav class="navbar top-navbar">
            <div class="container-fluid">
                <button class="btn btn-sm" id="sidebarToggle"><i class="bi bi-list fs-5"></i></button>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="badge bg-secondary"><i class="bi bi-clock me-1"></i><span id="liveClock"></span></span>
                    <span class="badge bg-success"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>CEMS Active</span>
                </div>
            </div>
        </nav>
        <div class="container-fluid px-4 pt-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (ViewBag.Warning != null)
            {
                <div class="alert alert-warning alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.Warning
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
        <main class="container-fluid px-4 pb-4">@RenderBody()</main>
    </div>
</div>
}
else
{
    @RenderBody()
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    function updateClock(){const n=new Date();const el=document.getElementById('liveClock');if(el)el.textContent=n.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});}
    setInterval(updateClock,1000);updateClock();
    document.getElementById('sidebarToggle')?.addEventListener('click',()=>{document.getElementById('wrapper').classList.toggle('sidebar-collapsed');});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
