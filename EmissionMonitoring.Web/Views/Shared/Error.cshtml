@model EmissionMonitoring.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="d-flex align-items-center justify-content-center" style="min-height:60vh;">
    <div class="text-center">
        <div class="mb-4" style="width:90px;height:90px;background:linear-gradient(135deg,#fd7e14,#dc3545);border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto;">
            <i class="bi bi-exclamation-triangle text-white" style="font-size:2.5rem;"></i>
        </div>
        <h3 class="fw-bold mb-2">Something went wrong</h3>
        <p class="text-muted mb-1">An unexpected error occurred. Please try again.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="text-muted small mb-4">Request ID: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-success">
            <i class="bi bi-house me-2"></i>Back to Dashboard
        </a>
    </div>
</div>
